# Development environment configuration

project_id  = "retire-plan-dev"
region      = "us-central1"
environment = "development"

service_name = "retire-plan-dev"
cloud_run_image = "us-central1-docker.pkg.dev/retire-plan-dev/retire-plan/retire-plan:latest"

# Dev scaling (scale to zero to save costs)
min_instances = 0
max_instances = 5

# Dev resources (smaller to save costs)
memory_limit = "512Mi"
cpu_limit    = "1"

# Development can have longer timeout for debugging
timeout_seconds = 600
