# Example Terraform variables file
# Copy this to terraform.tfvars and update with your values
# WARNING: Do NOT commit terraform.tfvars to Git!

# GCP Configuration
project_id = "your-gcp-project-id"
region     = "us-central1"
environment = "production"

# Service Configuration
service_name = "retire-plan"

# Docker image (update after building)
# Format: region-docker.pkg.dev/project-id/repository-id/image-name:tag
cloud_run_image = "us-central1-docker.pkg.dev/your-gcp-project-id/retire-plan/retire-plan:latest"

# Artifact Registry
artifact_registry_repository_id = "retire-plan"

# Public Environment Variables (non-sensitive)
public_env_vars = {
  # Firebase configuration (public)
  NEXT_PUBLIC_FIREBASE_API_KEY       = "AIza..."
  NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN   = "your-project.firebaseapp.com"
  NEXT_PUBLIC_FIREBASE_PROJECT_ID    = "your-project-id"
  FIREBASE_PROJECT_ID                = "your-project-id"
  FIREBASE_CLIENT_EMAIL              = "firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
}

# Secret Environment Variables (references to Secret Manager)
# The actual secret values are set separately using gcloud CLI.
# These are fetched at container start — only list secrets the app reads.
secret_env_vars = {
  DATABASE_URL = {
    secret_name = "DATABASE_URL"
    version     = "latest"
  }
  FIREBASE_PRIVATE_KEY = {
    secret_name = "FIREBASE_PRIVATE_KEY"
    version     = "latest"
  }
}

# Cloud Run Resource Configuration
memory_limit    = "512Mi"
cpu_limit       = "1"
min_instances   = 0
max_instances   = 10
timeout_seconds = 300

# Access Control
allow_unauthenticated = true

# Cloud Build (for GitHub integration)
enable_cloud_build_trigger = true
cloud_build_trigger_name        = "deploy-production"
cloud_build_service_account     = "projects/YOUR_PROJECT_ID/serviceAccounts/YOUR_PROJECT_NUMBER-compute@developer.gserviceaccount.com"
github_owner                    = "your-github-username"
github_repo                     = "retirement-planner"

# Build-time substitutions — baked into the client JS bundle by next build.
# Distinct from public_env_vars (Cloud Run runtime): NEXT_PUBLIC_* values must
# exist when `docker build` runs, not just when the container starts.
# Keys must start with _ per Cloud Build convention.
build_substitutions = {
  _FIREBASE_API_KEY             = "AIza..."
  _FIREBASE_AUTH_DOMAIN         = "your-project.firebaseapp.com"
  _FIREBASE_PROJECT_ID          = "your-project-id"
  _FIREBASE_STORAGE_BUCKET      = "your-project.firebasestorage.app"
  _FIREBASE_MESSAGING_SENDER_ID = "123456789"
  _FIREBASE_APP_ID              = "1:123456789:web:abc123"
  _FIREBASE_MEASUREMENT_ID      = "G-XXXXXXXXXX"
}

# Rust Simulation Service Configuration
rust_service_name     = "rust-simulation-service"
rust_service_image    = "us-central1-docker.pkg.dev/your-gcp-project-id/retire-plan/rust-simulation:latest"
# 4 vCPU / 2Gi: Rayon parallelizes paths across cores, so more cores cut
# wall-clock at roughly the same vCPU-second cost. Cloud Run requires >=2Gi at
# 4 vCPU. Concurrency is pinned to 1 in main.tf so a request gets all cores.
rust_memory_limit     = "2Gi"
rust_cpu_limit        = "4"
rust_min_instances    = 0
rust_max_instances    = 10
rust_timeout_seconds  = 120
