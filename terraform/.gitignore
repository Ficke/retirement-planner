# Terraform .gitignore

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Local variable files may contain sensitive data. Production configuration is
# intentionally versioned because it contains references and public values.
*.tfvars
*.tfvars.json
!production.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc
