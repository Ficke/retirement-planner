{
  "name": "retire-plan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -C apps/web dev",
    "dev:rust": "cargo run --release --manifest-path rust-simulation-service/Cargo.toml",
    "build": "pnpm -C apps/web build",
    "start": "pnpm -C apps/web start",
    "lint": "pnpm -C apps/web lint",
    "typecheck": "pnpm -C apps/web typecheck",
    "test": "pnpm -C apps/web test",
    "test:ui": "pnpm -C apps/web test:ui",
    "e2e": "pnpm -C apps/web e2e",
    "e2e:ui": "pnpm -C apps/web e2e:ui",
    "wasm:build": "pnpm exec wasm-pack build rust-simulation-service --target web --out-dir ../apps/web/src/wasm --out-name retirement_simulation --release && node scripts/check-wasm-artifact.mjs --write",
    "wasm:check": "node scripts/check-wasm-artifact.mjs",
    "clean": "rm -rf apps/*/node_modules apps/*/.next apps/*/dist apps/*/dist-server",
    "install:all": "pnpm install",
    "bootstrap": "node scripts/bootstrap"
  },
  "devDependencies": {
    "typescript": "^5",
    "wasm-pack": "0.15.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": "7.6.5",
      "websocket-driver": "0.7.5",
      "jws@<3.2.3": "3.2.3",
      "jws@>=4.0.0 <4.0.1": "4.0.1",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "postcss@<=8.5.22": "8.5.23",
      "@grpc/grpc-js": "1.14.4",
      "form-data@<2.5.6": "2.5.6",
      "sharp": "0.35.0",
      "uuid": "11.1.1",
      "@tootallnate/once": "2.0.1"
    }
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
