#!/usr/bin/env node

import { createInterface } from 'readline';
import { readFileSync, writeFileSync, existsSync } from 'fs';
import { execSync } from 'child_process';
import { resolve, dirname } from 'path';
import { fileURLToPath } from 'url';

const __dirname = dirname(fileURLToPath(import.meta.url));
const ENV_PATH = resolve(__dirname, '..', 'apps', 'web', '.env.local');
const TFVARS_PATH = resolve(__dirname, '..', 'terraform', 'terraform.tfvars');

const rl = createInterface({ input: process.stdin, output: process.stdout });

function ask(question, defaultValue = '') {
  const suffix = defaultValue ? ` [${defaultValue}]` : '';
  return new Promise((resolve) => {
    rl.question(`  ${question}${suffix}: `, (answer) => {
      resolve(answer.trim() || defaultValue);
    });
  });
}

function printHeader(text) {
  console.log(`\n\x1b[1m${text}\x1b[0m`);
}

function printSuccess(text) {
  console.log(`\x1b[32m${text}\x1b[0m`);
}

function printWarning(text) {
  console.log(`\x1b[33m${text}\x1b[0m`);
}

function printInfo(text) {
  console.log(`\x1b[36m${text}\x1b[0m`);
}

// --- GCP helpers ---

function hasGcloud() {
  try {
    execSync('gcloud --version', { stdio: 'ignore' });
    return true;
  } catch {
    return false;
  }
}

function gcloudSecret(secretName, projectId) {
  try {
    return execSync(
      `gcloud secrets versions access latest --secret=${secretName} --project=${projectId}`,
      { encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] }
    ).trim();
  } catch {
    return null;
  }
}

function parseTfvars(path) {
  const content = readFileSync(path, 'utf-8');
  const vars = {};

  // Parse simple key = "value" lines
  for (const match of content.matchAll(/^(\w+)\s*=\s*"([^"]*)"/gm)) {
    vars[match[1]] = match[2];
  }

  // Parse public_env_vars block
  const blockMatch = content.match(/public_env_vars\s*=\s*\{([\s\S]*?)\n\}/);
  if (blockMatch) {
    for (const line of blockMatch[1].matchAll(/(\w+)\s*=\s*"([^"]*)"/g)) {
      vars[line[1]] = line[2];
    }
  }

  // Parse secret_env_vars to get secret names
  const secretBlock = content.match(/secret_env_vars\s*=\s*\{([\s\S]*?)\n\}/);
  if (secretBlock) {
    vars._secrets = [];
    for (const match of secretBlock[1].matchAll(/secret_name\s*=\s*"([^"]*)"/g)) {
      vars._secrets.push(match[1]);
    }
  }

  return vars;
}

// --- Setup modes ---

async function setupFromGcp() {
  const tfvars = parseTfvars(TFVARS_PATH);
  const gcpProject = tfvars.project_id;

  printInfo(`  GCP project: ${gcpProject}`);
  printInfo(`  Firebase project: ${tfvars.FIREBASE_PROJECT_ID || tfvars.NEXT_PUBLIC_FIREBASE_PROJECT_ID}`);

  // Set gcloud project
  console.log(`\n  Setting gcloud project...`);
  try {
    execSync(`gcloud config set project ${gcpProject}`, { stdio: 'ignore' });
  } catch {
    printWarning('  Could not set gcloud project. Make sure you are authenticated: gcloud auth login');
    return null;
  }

  // Pull secrets
  printHeader('Pulling secrets from GCP Secret Manager');
  const secrets = {};
  const secretNames = ['DATABASE_URL', 'FIREBASE_PRIVATE_KEY', 'GEMINI_API_KEY'];

  for (const name of secretNames) {
    process.stdout.write(`  ${name}... `);
    const value = gcloudSecret(name, gcpProject);
    if (value) {
      secrets[name] = value;
      printSuccess('OK');
    } else {
      printWarning('not found (skipped)');
    }
  }

  // Build env content from tfvars public config + secrets
  const envContent = `# Generated by pnpm setup (from GCP)
# ${new Date().toISOString()}

# Database
DATABASE_URL=${secrets.DATABASE_URL || 'postgresql://localhost:5432/retire_dev'}

# Firebase Authentication (client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=${tfvars.NEXT_PUBLIC_FIREBASE_API_KEY || ''}
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=${tfvars.NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN || ''}
NEXT_PUBLIC_FIREBASE_PROJECT_ID=${tfvars.NEXT_PUBLIC_FIREBASE_PROJECT_ID || ''}
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=${tfvars.NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET || ''}
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=${tfvars.NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID || ''}
NEXT_PUBLIC_FIREBASE_APP_ID=${tfvars.NEXT_PUBLIC_FIREBASE_APP_ID || ''}
${tfvars.NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID ? `NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=${tfvars.NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID}` : '# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID= (optional)'}

# Firebase Authentication (server-side)
FIREBASE_PROJECT_ID=${tfvars.FIREBASE_PROJECT_ID || tfvars.NEXT_PUBLIC_FIREBASE_PROJECT_ID || ''}
FIREBASE_CLIENT_EMAIL=${tfvars.FIREBASE_CLIENT_EMAIL || ''}
FIREBASE_PRIVATE_KEY="${secrets.FIREBASE_PRIVATE_KEY || ''}"

# Optional: Gemini API for OCR
${secrets.GEMINI_API_KEY ? `GEMINI_API_KEY=${secrets.GEMINI_API_KEY}` : '# GEMINI_API_KEY= (optional, enables OCR features)'}

# Environment
NODE_ENV=development
`;

  return envContent;
}

async function setupManual() {
  // Step 1: Database
  printHeader('Step 1/3: Database');
  const databaseUrl = await ask(
    'PostgreSQL connection URL',
    'postgresql://localhost:5432/retire_dev'
  );

  if (!databaseUrl.startsWith('postgresql://') && !databaseUrl.startsWith('postgres://')) {
    printWarning('Warning: DATABASE_URL should start with postgresql:// or postgres://');
  }

  // Step 2: Firebase
  printHeader('Step 2/3: Firebase Authentication');
  console.log('  Get these from Firebase Console > Project Settings\n');

  const projectId = await ask('Firebase Project ID');
  if (!projectId) {
    printWarning('Warning: Firebase Project ID is required for auth to work');
  }

  const authDomain = `${projectId}.firebaseapp.com`;
  const storageBucket = `${projectId}.firebasestorage.app`;
  console.log(`  Auth Domain: ${authDomain} (auto-derived)`);
  console.log(`  Storage Bucket: ${storageBucket} (auto-derived)\n`);

  const apiKey = await ask('Firebase API Key');
  const appId = await ask('Firebase App ID');
  const messagingSenderId = await ask('Firebase Messaging Sender ID');
  const measurementId = await ask('Firebase Measurement ID (Enter to skip)');

  // Server-side Firebase (service account)
  console.log('\n  Server-side auth (from Service Accounts > Generate new private key)\n');

  let clientEmail = '';
  let privateKey = '';

  const saInput = await ask('Path to service account JSON file (or paste client email)');

  if (saInput.endsWith('.json')) {
    const saPath = resolve(process.cwd(), saInput);
    try {
      const sa = JSON.parse(readFileSync(saPath, 'utf-8'));
      clientEmail = sa.client_email || '';
      privateKey = sa.private_key || '';
      printSuccess(`  Extracted client_email and private_key from ${saInput}`);
    } catch (err) {
      printWarning(`  Could not read ${saPath}: ${err.message}`);
      clientEmail = await ask('Firebase Client Email');
      privateKey = await ask('Firebase Private Key (paste the full key)');
    }
  } else {
    clientEmail = saInput;
    if (!clientEmail) {
      clientEmail = await ask('Firebase Client Email');
    }
    privateKey = await ask('Firebase Private Key (paste the full key)');
  }

  // Step 3: Optional
  printHeader('Step 3/3: Optional Services');
  const geminiApiKey = await ask('Gemini API Key for OCR (Enter to skip)');

  return `# Generated by pnpm setup
# ${new Date().toISOString()}

# Database
DATABASE_URL=${databaseUrl}

# Firebase Authentication (client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=${apiKey}
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=${authDomain}
NEXT_PUBLIC_FIREBASE_PROJECT_ID=${projectId}
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=${storageBucket}
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=${messagingSenderId}
NEXT_PUBLIC_FIREBASE_APP_ID=${appId}
${measurementId ? `NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=${measurementId}` : '# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID= (optional, for Google Analytics)'}

# Firebase Authentication (server-side)
FIREBASE_PROJECT_ID=${projectId}
FIREBASE_CLIENT_EMAIL=${clientEmail}
FIREBASE_PRIVATE_KEY="${privateKey}"

# Optional: Gemini API for OCR
${geminiApiKey ? `GEMINI_API_KEY=${geminiApiKey}` : '# GEMINI_API_KEY= (optional, enables OCR features)'}

# Environment
NODE_ENV=development
`;
}

// --- Main ---

async function main() {
  console.log('\n\x1b[1mRetire Plan - Dev Setup\x1b[0m\n');

  // Check for existing .env.local
  if (existsSync(ENV_PATH)) {
    const overwrite = await ask('apps/web/.env.local already exists. Overwrite? (y/N)', 'N');
    if (overwrite.toLowerCase() !== 'y') {
      console.log('Setup cancelled.');
      rl.close();
      process.exit(0);
    }
  }

  let envContent = null;

  // Auto-detect GCP setup
  const hasTfvars = existsSync(TFVARS_PATH);
  const hasGcl = hasGcloud();

  if (hasTfvars && hasGcl) {
    printInfo('  Detected: terraform.tfvars + gcloud CLI');
    const mode = await ask('Pull config from GCP automatically? (Y/n)', 'Y');

    if (mode.toLowerCase() !== 'n') {
      envContent = await setupFromGcp();
      if (!envContent) {
        printWarning('\n  GCP setup failed, falling back to manual setup...');
      }
    }
  } else if (hasTfvars && !hasGcl) {
    printInfo('  Found terraform.tfvars but gcloud CLI not installed.');
    printInfo('  Install gcloud for automatic setup: https://cloud.google.com/sdk/docs/install');
  }

  // Fall back to manual
  if (!envContent) {
    envContent = await setupManual();
  }

  writeFileSync(ENV_PATH, envContent);
  printSuccess(`\nWrote ${ENV_PATH}`);

  console.log('\n\x1b[1mNext steps:\x1b[0m');
  console.log('  1. pnpm install');
  console.log('  2. pnpm dev\n');

  rl.close();
}

main().catch((err) => {
  console.error('Setup failed:', err.message);
  rl.close();
  process.exit(1);
});
