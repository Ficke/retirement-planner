#!/usr/bin/env node

import { createInterface } from 'readline';
import { readFileSync, writeFileSync, existsSync } from 'fs';
import { execSync } from 'child_process';
import { resolve, dirname } from 'path';
import { fileURLToPath } from 'url';

const __dirname = dirname(fileURLToPath(import.meta.url));
const ENV_PATH = resolve(__dirname, '..', 'apps', 'web', '.env.local');
const TFVARS_PATH = resolve(__dirname, '..', 'terraform', 'terraform.tfvars');

const rl = createInterface({ input: process.stdin, output: process.stdout });

function ask(question, defaultValue = '') {
  const suffix = defaultValue ? ` [${defaultValue}]` : '';
  return new Promise((resolve) => {
    rl.question(`  ${question}${suffix}: `, (answer) => {
      resolve(answer.trim() || defaultValue);
    });
  });
}

function printHeader(text) {
  console.log(`\n\x1b[1m${text}\x1b[0m`);
}

function printSuccess(text) {
  console.log(`\x1b[32m${text}\x1b[0m`);
}

function printWarning(text) {
  console.log(`\x1b[33m${text}\x1b[0m`);
}

function printInfo(text) {
  console.log(`\x1b[36m${text}\x1b[0m`);
}

// --- CLI detection ---

function hasCmd(cmd) {
  try {
    execSync(`command -v ${cmd}`, { stdio: 'ignore' });
    return true;
  } catch {
    return false;
  }
}

// --- GCP helpers ---

function gcloudSecret(secretName, projectId) {
  try {
    return execSync(
      `gcloud secrets versions access latest --secret=${secretName} --project=${projectId}`,
      { encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] }
    ).trim();
  } catch {
    return null;
  }
}

function getGcloudProject() {
  try {
    return execSync('gcloud config get-value project', {
      encoding: 'utf-8',
      stdio: ['pipe', 'pipe', 'pipe'],
    }).trim();
  } catch {
    return null;
  }
}

function pullSecrets(projectId) {
  printHeader('Pulling secrets from GCP Secret Manager');
  const secrets = {};
  const secretNames = ['DATABASE_URL', 'FIREBASE_PRIVATE_KEY'];

  for (const name of secretNames) {
    process.stdout.write(`  ${name}... `);
    const value = gcloudSecret(name, projectId);
    if (value) {
      secrets[name] = value;
      printSuccess('OK');
    } else {
      printWarning('not found (skipped)');
    }
  }

  return secrets;
}

// --- Firebase CLI helpers ---

function getFirebaseConfig() {
  try {
    const output = execSync('firebase apps:sdkconfig web --json', {
      encoding: 'utf-8',
      stdio: ['pipe', 'pipe', 'pipe'],
    });
    const parsed = JSON.parse(output);
    // firebase CLI returns { status: "success", result: { sdkConfig: { ... } } }
    const config = parsed?.result?.sdkConfig;
    if (!config?.apiKey) return null;
    return config;
  } catch {
    return null;
  }
}

function getFirebaseServiceAccount(projectId) {
  // Try to find the firebase-adminsdk service account via gcloud
  try {
    const accounts = execSync(
      `gcloud iam service-accounts list --project=${projectId} --format="value(email)" --filter="email:firebase-adminsdk"`,
      { encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] }
    ).trim();
    return accounts.split('\n')[0] || null;
  } catch {
    return null;
  }
}

// --- tfvars parser ---

function parseTfvars(path) {
  const content = readFileSync(path, 'utf-8');
  const vars = {};

  for (const match of content.matchAll(/^(\w+)\s*=\s*"([^"]*)"/gm)) {
    vars[match[1]] = match[2];
  }

  const blockMatch = content.match(/public_env_vars\s*=\s*\{([\s\S]*?)\n\}/);
  if (blockMatch) {
    for (const line of blockMatch[1].matchAll(/(\w+)\s*=\s*"([^"]*)"/g)) {
      vars[line[1]] = line[2];
    }
  }

  return vars;
}

// --- Env file builder ---

function buildEnv({ firebase, serverSide, secrets }) {
  const fb = firebase || {};
  const sv = serverSide || {};
  const sc = secrets || {};

  return `# Generated by pnpm bootstrap
# ${new Date().toISOString()}

# Database
DATABASE_URL=${sc.DATABASE_URL || 'postgresql://localhost:5432/retire_dev'}

# Firebase Authentication (client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=${fb.apiKey || ''}
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=${fb.authDomain || ''}
NEXT_PUBLIC_FIREBASE_PROJECT_ID=${fb.projectId || ''}
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=${fb.storageBucket || ''}
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=${fb.messagingSenderId || ''}
NEXT_PUBLIC_FIREBASE_APP_ID=${fb.appId || ''}
${fb.measurementId ? `NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=${fb.measurementId}` : '# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID= (optional)'}

# Firebase Authentication (server-side)
FIREBASE_PROJECT_ID=${sv.projectId || fb.projectId || ''}
FIREBASE_CLIENT_EMAIL=${sv.clientEmail || ''}
FIREBASE_PRIVATE_KEY="${sc.FIREBASE_PRIVATE_KEY || ''}"

# Environment
NODE_ENV=development
`;
}

// --- Setup modes ---

async function setupFromCli() {
  const hasGcloud = hasCmd('gcloud');
  const hasFirebase = hasCmd('firebase');

  if (!hasGcloud && !hasFirebase) return null;

  printInfo(`  Detected CLIs: ${[hasGcloud && 'gcloud', hasFirebase && 'firebase'].filter(Boolean).join(', ')}`);

  // Get GCP project
  let gcpProject = null;
  if (hasGcloud) {
    gcpProject = getGcloudProject();
    if (gcpProject) {
      printInfo(`  GCP project: ${gcpProject}`);
    } else {
      printWarning('  gcloud found but no active project. Run: gcloud config set project <PROJECT_ID>');
    }
  }

  // Get Firebase config via CLI
  let firebase = null;
  if (hasFirebase) {
    printHeader('Pulling Firebase config via CLI');
    process.stdout.write('  firebase apps:sdkconfig web... ');
    firebase = getFirebaseConfig();
    if (firebase) {
      printSuccess('OK');
      printInfo(`  Project: ${firebase.projectId}`);
    } else {
      printWarning('failed (is there a web app configured?)');
    }
  }

  // Get server-side Firebase config
  const serverSide = {};
  const projectId = firebase?.projectId || gcpProject;
  if (projectId) {
    serverSide.projectId = projectId;
  }
  if (hasGcloud && projectId) {
    process.stdout.write('  Looking up Firebase service account... ');
    const email = getFirebaseServiceAccount(projectId);
    if (email) {
      serverSide.clientEmail = email;
      printSuccess(email);
    } else {
      printWarning('not found');
    }
  }

  // Pull secrets
  let secrets = {};
  if (hasGcloud && gcpProject) {
    secrets = pullSecrets(gcpProject);
  }

  if (!firebase && Object.keys(secrets).length === 0) {
    return null;
  }

  return buildEnv({ firebase, serverSide, secrets });
}

async function setupFromTfvars() {
  if (!existsSync(TFVARS_PATH)) return null;

  const hasGcloud = hasCmd('gcloud');
  const tfvars = parseTfvars(TFVARS_PATH);
  const gcpProject = tfvars.project_id;

  printInfo(`  Using terraform.tfvars (GCP project: ${gcpProject})`);

  if (hasGcloud && gcpProject) {
    try {
      execSync(`gcloud config set project ${gcpProject}`, { stdio: 'ignore' });
    } catch {
      printWarning('  Could not set gcloud project. Run: gcloud auth login');
    }
  }

  const secrets = hasGcloud && gcpProject ? pullSecrets(gcpProject) : {};

  return buildEnv({
    firebase: {
      apiKey: tfvars.NEXT_PUBLIC_FIREBASE_API_KEY,
      authDomain: tfvars.NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN,
      projectId: tfvars.NEXT_PUBLIC_FIREBASE_PROJECT_ID,
      storageBucket: tfvars.NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET,
      messagingSenderId: tfvars.NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID,
      appId: tfvars.NEXT_PUBLIC_FIREBASE_APP_ID,
      measurementId: tfvars.NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID,
    },
    serverSide: {
      projectId: tfvars.FIREBASE_PROJECT_ID || tfvars.NEXT_PUBLIC_FIREBASE_PROJECT_ID,
      clientEmail: tfvars.FIREBASE_CLIENT_EMAIL,
    },
    secrets,
  });
}

async function setupManual() {
  // Step 1: Database
  printHeader('Step 1/2: Database');
  const databaseUrl = await ask(
    'PostgreSQL connection URL',
    'postgresql://localhost:5432/retire_dev'
  );

  if (!databaseUrl.startsWith('postgresql://') && !databaseUrl.startsWith('postgres://')) {
    printWarning('Warning: DATABASE_URL should start with postgresql:// or postgres://');
  }

  // Step 2: Firebase
  printHeader('Step 2/2: Firebase Authentication');
  console.log('  Get these from Firebase Console > Project Settings\n');

  const projectId = await ask('Firebase Project ID');
  if (!projectId) {
    printWarning('Warning: Firebase Project ID is required for auth to work');
  }

  const authDomain = `${projectId}.firebaseapp.com`;
  const storageBucket = `${projectId}.firebasestorage.app`;
  console.log(`  Auth Domain: ${authDomain} (auto-derived)`);
  console.log(`  Storage Bucket: ${storageBucket} (auto-derived)\n`);

  const apiKey = await ask('Firebase API Key');
  const appId = await ask('Firebase App ID');
  const messagingSenderId = await ask('Firebase Messaging Sender ID');
  const measurementId = await ask('Firebase Measurement ID (Enter to skip)');

  // Server-side Firebase (service account)
  console.log('\n  Server-side auth (from Service Accounts > Generate new private key)\n');

  let clientEmail = '';
  let privateKey = '';

  const saInput = await ask('Path to service account JSON file (or paste client email)');

  if (saInput.endsWith('.json')) {
    const saPath = resolve(process.cwd(), saInput);
    try {
      const sa = JSON.parse(readFileSync(saPath, 'utf-8'));
      clientEmail = sa.client_email || '';
      privateKey = sa.private_key || '';
      printSuccess(`  Extracted client_email and private_key from ${saInput}`);
    } catch (err) {
      printWarning(`  Could not read ${saPath}: ${err.message}`);
      clientEmail = await ask('Firebase Client Email');
      privateKey = await ask('Firebase Private Key (paste the full key)');
    }
  } else {
    clientEmail = saInput;
    if (!clientEmail) {
      clientEmail = await ask('Firebase Client Email');
    }
    privateKey = await ask('Firebase Private Key (paste the full key)');
  }

  return buildEnv({
    firebase: {
      apiKey,
      authDomain,
      projectId,
      storageBucket,
      messagingSenderId,
      appId,
      measurementId,
    },
    serverSide: { projectId, clientEmail },
    secrets: {
      DATABASE_URL: databaseUrl,
      FIREBASE_PRIVATE_KEY: privateKey,
    },
  });
}

// --- Main ---

async function main() {
  console.log('\n\x1b[1mRetire Plan - Bootstrap\x1b[0m\n');

  // Check for existing .env.local
  if (existsSync(ENV_PATH)) {
    const overwrite = await ask('apps/web/.env.local already exists. Overwrite? (y/N)', 'N');
    if (overwrite.toLowerCase() !== 'y') {
      console.log('Setup cancelled.');
      rl.close();
      process.exit(0);
    }
  }

  let envContent = null;

  // 1. Try Firebase CLI + gcloud CLI (fully automatic)
  const hasClis = hasCmd('gcloud') || hasCmd('firebase');
  if (hasClis) {
    const mode = await ask('Pull config from GCP/Firebase CLIs automatically? (Y/n)', 'Y');
    if (mode.toLowerCase() !== 'n') {
      envContent = await setupFromCli();
      if (!envContent) {
        printWarning('\n  CLI setup failed or returned no config.');
      }
    }
  }

  // 2. Try terraform.tfvars + gcloud
  if (!envContent && existsSync(TFVARS_PATH)) {
    printInfo('  Falling back to terraform.tfvars...');
    envContent = await setupFromTfvars();
  }

  // 3. Manual entry
  if (!envContent) {
    if (hasClis || existsSync(TFVARS_PATH)) {
      printWarning('\n  Falling back to manual setup...');
    }
    envContent = await setupManual();
  }

  writeFileSync(ENV_PATH, envContent);
  printSuccess(`\nWrote ${ENV_PATH}`);

  console.log('\n\x1b[1mNext steps:\x1b[0m');
  console.log('  1. pnpm install');
  console.log('  2. pnpm dev\n');

  rl.close();
}

main().catch((err) => {
  console.error('Bootstrap failed:', err.message);
  rl.close();
  process.exit(1);
});
