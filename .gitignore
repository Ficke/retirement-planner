# =========================
# Monorepo .gitignore (Node/Next + Rust + Terraform)
# =========================

# Node / Next.js (recursive for packages/apps)
node_modules/
**/node_modules/
.next/
**/.next/
dist/
**/dist/
build/
**/build/
out/
**/out/
coverage/
**/coverage/
playwright-report/
**/playwright-report/
test-results/
**/test-results/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# Rust build artifacts
debug/
target/
**/target/
**/*.rs.bk
# Cargo.lock is committed for applications to ensure reproducible builds

# Terraform state and caches
.terraform/
**/.terraform/
terraform.tfstate
terraform.tfstate.*
**/terraform.tfstate
**/terraform.tfstate.*
**/*.tfplan
**/crash.log
terraform.tfvars
**/terraform.tfvars

# Claude Code
.claude/

# OS / Editor
.DS_Store
.vscode/
**/.vscode/
.idea/
**/.idea/

# Misc
*.local
uploads/

# Test files
apps/web/test-seedrandom.js
apps/web/tests/server-client-comparison.test.ts