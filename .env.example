# =============================================================================
# MONOREPO ENVIRONMENT VARIABLES
# =============================================================================
# Copy apps/web/.env.example to apps/web/.env.local.
# Vite and the local Hono server load variables from the app directory.

# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# =============================================================================
# These must be set for the application to run

# Database Configuration (REQUIRED)
# PostgreSQL connection string
#
# Recommended: Neon PostgreSQL (https://neon.tech) - Free tier available
# - Create a project at https://console.neon.tech
# - Copy the connection string (use the pooler endpoint for better performance)
# - Format: postgresql://[user]:[password]@[host]-pooler.neon.tech/[dbname]?sslmode=require
#
# Alternative: Local PostgreSQL
# - Install PostgreSQL locally
# - Create database: createdb retire_dev
# - Format: postgresql://localhost:5432/retire_dev
#
# Production: Use managed PostgreSQL (Neon, Google Cloud SQL, AWS RDS, etc.)
DATABASE_URL=postgresql://your_neon_connection_string_here

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Firebase Authentication - Get credentials from Firebase Console
# See apps/web/.env.example for detailed setup instructions

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PROJECT_ID=your-project-id

# =============================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# =============================================================================
# These enable additional features but app can run without them

# Rust simulation service (server-first Monte Carlo engine)
# Unset locally, the app falls back to the client-side Web Worker.
# Local: http://localhost:8081   Cloud Run: set by Terraform / Cloud Build
RUST_SERVICE_URL=http://localhost:8081

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment mode
NODE_ENV=development
