# =============================================================================
# MONOREPO ENVIRONMENT VARIABLES
# =============================================================================
# NOTE: For the Next.js app, copy apps/web/.env.example to apps/web/.env.local
# Next.js loads environment variables from the app directory, not the root.

# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# =============================================================================
# These must be set for the application to run

# Database Configuration (REQUIRED)
# PostgreSQL connection string
#
# Recommended: Neon PostgreSQL (https://neon.tech) - Free tier available
# - Create a project at https://console.neon.tech
# - Copy the connection string (use the pooler endpoint for better performance)
# - Format: postgresql://[user]:[password]@[host]-pooler.neon.tech/[dbname]?sslmode=require
#
# Alternative: Local PostgreSQL
# - Install PostgreSQL locally
# - Create database: createdb retire_dev
# - Format: postgresql://localhost:5432/retire_dev
#
# Production: Use managed PostgreSQL (Neon, Google Cloud SQL, AWS RDS, etc.)
DATABASE_URL=postgresql://your_neon_connection_string_here

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Firebase Authentication - Get credentials from Firebase Console
# See apps/web/.env.example for detailed setup instructions

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# =============================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# =============================================================================
# These enable additional features but app can run without them

# Gemini API Configuration (for OCR functionality)
# Get your API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Polygon.io API Configuration (for stock/ETF price fetching)
# Get your free API key at https://polygon.io/dashboard
POLYGON_API_KEY=your_polygon_api_key_here

# Rate limiting configuration (adjust based on your Polygon plan)
# Free tier: 5 requests per minute
# Basic tier: 100 requests per minute
POLYGON_RATE_LIMIT_PER_MINUTE=5

# Langfuse Configuration (for OCR observability)
# Get your API keys at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment mode
NODE_ENV=development