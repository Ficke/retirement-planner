# =============================================================================
# ENVIRONMENT VARIABLES FOR NEXT.JS APP
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Next.js loads environment variables from apps/web/.env.local

# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# =============================================================================
# These must be set for the application to run

# Database Configuration (REQUIRED)
# PostgreSQL connection string
# Local development: postgresql://localhost:5432/retire_dev
# Production: Use your cloud database URL (e.g., Google Cloud SQL, AWS RDS, etc.)
DATABASE_URL=postgresql://localhost:5432/retire_dev

# Firebase Authentication Configuration (REQUIRED)
# Get these from Firebase Console: Project Settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin SDK Configuration (REQUIRED for server-side)
# Get these from Firebase Console: Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# =============================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# =============================================================================
# These enable additional features but app can run without them

# Gemini API Configuration (for OCR functionality)
# Get your API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Polygon.io API Configuration (for stock/ETF price fetching)
# Get your free API key at https://polygon.io/dashboard
POLYGON_API_KEY=your_polygon_api_key_here

# Rate limiting configuration (adjust based on your Polygon plan)
# Free tier: 5 requests per minute
# Basic tier: 100 requests per minute
POLYGON_RATE_LIMIT_PER_MINUTE=5

# Langfuse Configuration (for OCR observability)
# Get your API keys at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment mode
NODE_ENV=development
