# =============================================================================
# ENVIRONMENT VARIABLES FOR NEXT.JS APP
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Next.js loads environment variables from apps/web/.env.local

# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# =============================================================================
# These must be set for the application to run

# Database Configuration (REQUIRED)
# PostgreSQL connection string
# Local development: postgresql://localhost:5432/retire_dev
# Production: Use your cloud database URL (e.g., Google Cloud SQL, AWS RDS, etc.)
DATABASE_URL=postgresql://localhost:5432/retire_dev

# Firebase Authentication Configuration (REQUIRED)
# Get these from Firebase Console: Project Settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Signup invite codes (REQUIRED)
# Comma-separated. Creating an account requires one of these; leaving this
# unset closes signup entirely.
SIGNUP_INVITE_CODES=dev-invite

# Firebase Admin SDK Configuration (REQUIRED for server-side)
# Get these from Firebase Console: Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# =============================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# =============================================================================
# These enable additional features but app can run without them

# Rust simulation service (server-first Monte Carlo engine)
# Unset locally, the app falls back to the client-side Web Worker.
# Local: http://localhost:8081   Cloud Run: set by Terraform / Cloud Build
RUST_SERVICE_URL=http://localhost:8081

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment mode
NODE_ENV=development
