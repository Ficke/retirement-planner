# =============================================================================
# ENVIRONMENT VARIABLES FOR VITE + HONO APP
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Vite and the local server load variables from apps/web/.env.local

# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# =============================================================================
# These must be set for the application to run

# Database Configuration (REQUIRED)
# PostgreSQL connection string
# Local development: postgresql://localhost:5432/retire_dev
# Production: Use your cloud database URL (e.g., Google Cloud SQL, AWS RDS, etc.)
DATABASE_URL=postgresql://localhost:5432/retire_dev

# Firebase Authentication Configuration (REQUIRED)
# Get these from Firebase Console: Project Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Signup invite codes (REQUIRED)
# Comma-separated. Creating an account requires one of these; leaving this
# unset closes signup entirely.
SIGNUP_INVITE_CODES=dev-invite

# Server-side Firebase token verification uses Google's public signing keys.
FIREBASE_PROJECT_ID=your-project-id

# =============================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# =============================================================================
# These enable additional features but app can run without them

# Rust simulation service (server-first Monte Carlo engine)
# Unset locally, the app falls back to the client-side Web Worker.
# Local: http://localhost:8081   Cloud Run: set by Terraform / Cloud Build
RUST_SERVICE_URL=http://localhost:8081

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment mode
NODE_ENV=development
