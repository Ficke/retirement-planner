{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "retire-plan-edge",
  "main": "./src/worker/index.ts",
  // Held at the newest date the vitest-pool-workers runtime supports, so the
  // Worker under test runs the same semantics it ships with. Raise both
  // together when the pool's workerd catches up.
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "not_found_handling": "single-page-application",
    // Everything outside this list is answered by the asset store without
    // invoking the Worker. Setting it to true instead routes every request
    // through the Worker, and past the free daily limit those requests return
    // 429 rather than falling back to asset serving.
    "run_worker_first": ["/api/*"]
  },

  // assets.directory is deliberately absent. The Vite plugin writes it into the
  // build's generated wrangler.json from the client build, and setting it here
  // conflicts with build.outDir.

  "vars": {
    "ORIGIN_URL": "https://retire-plan-lvs5yigt4a-uc.a.run.app"
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
