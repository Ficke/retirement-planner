{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names client,server \"pnpm dev:client\" \"pnpm dev:server\"",
    "dev:client": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "dev:server": "PORT=3001 NODE_ENV=development node --env-file-if-exists=.env.local --watch --import tsx src/server/index.ts",
    "build": "vite build && tsup --config tsup.config.ts",
    "start": "NODE_ENV=production node dist-server/index.cjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@hono/node-server": "^1.19.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@types/pg": "^8.15.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "firebase": "^12.17.1",
    "google-auth-library": "^11.0.1",
    "hono": "^4.9.0",
    "jose": "^6.2.8",
    "lucide-react": "^0.542.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.9.0",
    "recharts": "3.8.0",
    "seedrandom": "^3.0.5",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/seedrandom": "^3.0.8",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^6.0.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5",
    "typescript-eslint": "^8.42.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
