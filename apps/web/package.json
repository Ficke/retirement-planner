{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names client,server \"pnpm dev:client\" \"pnpm dev:server\"",
    "dev:client": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "dev:server": "PORT=3001 NODE_ENV=development node --env-file-if-exists=.env.local --watch --import tsx src/server/index.ts",
    "build": "pnpm -w wasm:check && vite build && tsup --config tsup.config.ts",
    "build:edge": "pnpm -w wasm:check && EDGE_BUILD=1 vite build && rm -f dist/retire_plan_edge/.dev.vars",
    "start": "NODE_ENV=production node dist-server/index.cjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit --project tsconfig.worker.json",
    "test": "vitest",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "deploy:edge": "wrangler deploy --strict",
    "deploy:edge:dry-run": "wrangler deploy --dry-run --strict",
    "types:worker": "wrangler types",
    "types:worker:check": "wrangler types --check",
    "check:worker": "pnpm types:worker:check && pnpm typecheck:worker && pnpm test:worker && pnpm build:edge && pnpm check:startup && pnpm deploy:edge:dry-run",
    "check:startup": "node ../../scripts/check-edge-startup.mjs",
    "e2e:worker": "playwright test --config playwright.worker.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@hono/node-server": "^1.19.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "firebase": "^12.18.0",
    "google-auth-library": "^11.0.2",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "lucide-react": "^0.542.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.6.0",
    "web-vitals": "^6.2.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "4.1.10",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^6.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.0",
    "vitest": "4.1.10",
    "wrangler": "4.129.1"
  }
}
